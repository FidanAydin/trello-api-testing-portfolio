  "item": [
    {
      "name": "Create board",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomNumber = Math.floor(Math.random() * 1000);\r",
              "const dynamicName = \"TrelloBoard_\" + randomNumber;\r",
              "\r",
              "pm.collectionVariables.set(\"currentBoardName\", dynamicName);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsonData = pm.response.json();\r",
              "\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is JSON\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "});\r",
              "\r",
              "pm.environment.set(\"boardID\", jsonData.id);\r",
              "\r",
              "pm.test(\"Board ID is generated\", function () {\r",
              "    pm.expect(jsonData.id).to.not.be.null;\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Status code name has string\", function () {\r",
              "    pm.response.to.have.status(\"OK\");\r",
              "});\r",
              "pm.test(\"Board name is correct\", function () {\r",
              "    \r",
              "\r",
              "    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get(\"currentBoardName\"));\r",
              "});\r",
              "pm.test(\"Board is not closed\", function () {\r",
              "    pm.expect(jsonData.closed).to.be.false;\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"lastBoardId\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseURL}}/1/boards/?name={{currentBoardName}}&key={{key}}&token={{token}}",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "1",
            "boards",
            ""
          ],
